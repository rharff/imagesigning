FROM golang:1.26.0-alpine3.22 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY pkg ./pkg

ENV CGO_ENABLED=0
RUN go build -trimpath -o /out/imgsign ./cmd/imgsign

FROM alpine:3.22.1

RUN apk add --no-cache ca-certificates \
    && addgroup -S imgsign \
    && adduser -S -G imgsign imgsign

COPY --from=builder /out/imgsign /usr/local/bin/imgsign

USER imgsign
ENTRYPOINT ["imgsign"]
