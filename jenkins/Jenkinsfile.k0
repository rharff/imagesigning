pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: buildah
    image: quay.io/buildah/stable:latest
    command: ['sleep', 'infinity']
    securityContext:
      privileged: true
  // - name: cosign
  //   image: cgr.dev/chainguard/cosign:latest
  //   command: ['sleep', 'infinity']
  //   securityContext:
  //     runAsUser: 0
"""
        }
    }

    environment {
        GHCR_USER  = "rharff"
        IMAGE_NAME = "ghcr.io/${GHCR_USER}/user-service"
        IMAGE_TAG  = "${BUILD_NUMBER}"
        IMAGE_FULL = "${IMAGE_NAME}:${IMAGE_TAG}"
        REPO_PATH  = "github.com/rharff/user-service.git"
    }

    stages {
        stage('Check Trigger') {
            steps {
                script {
                    def author = sh(
                        script: 'git log -1 --pretty=%an',
                        returnStdout: true
                    ).trim()

                    if (author == 'Jenkins') {
                        env.SKIP_BUILD = 'true'
                        currentBuild.result = 'NOT_BUILT'
                        echo "Commit terakhir dari Jenkins, pipeline dilewati."
                    } else {
                        env.SKIP_BUILD = 'false'
                    }
                }
            }
        }

        stage('Main Pipeline') {
            when { expression { env.SKIP_BUILD != 'true' } }
            stages {

                stage('Build Image') {
                    steps {
                        container('buildah') {
                            sh 'buildah build --label ci.build="$BUILD_NUMBER" -t "$IMAGE_FULL" .'
                        }
                    }
                }

                stage('Push & Get Digest') {
                    steps {
                        container('buildah') {
                            withCredentials([usernamePassword(
                                credentialsId: 'github-cred',
                                usernameVariable: 'DOCKER_USER',
                                passwordVariable: 'DOCKER_PASS'
                            )]) {
                                sh '''
                                    buildah push \
                                        --creds "$DOCKER_USER:$DOCKER_PASS" \
                                        --digestfile /tmp/image-digest \
                                        "$IMAGE_FULL" \
                                        "docker://$IMAGE_FULL"
                                '''

                                script {
                                    def digest = sh(
                                        script: 'cat /tmp/image-digest',
                                        returnStdout: true
                                    ).trim()

                                    if (!digest?.startsWith("sha256:")) {
                                        error("Failed to get valid digest, got: ${digest}")
                                    }

                                    env.IMAGE_REF = "${IMAGE_NAME}@${digest}"
                                    echo "IMAGE_REF set to: ${env.IMAGE_REF}"
                                }
                            }
                        }
                    }
                }

                // stage('Sign Image') {
                //     steps {
                //         container('cosign') {
                //             withCredentials([
                //                 file(credentialsId: 'cosign-private-key', variable: 'COSIGN_KEY'),
                //                 string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD'),
                //                 usernamePassword(
                //                     credentialsId: 'github-cred',
                //                     usernameVariable: 'DOCKER_USER',
                //                     passwordVariable: 'DOCKER_PASS'
                //                 )
                //             ]) {
                //                 sh '''
                //                     unset COSIGN_SIGNING_CONFIG
                //                     unset COSIGN_USE_SIGNING_CONFIG

                //                     cosign login ghcr.io -u "$DOCKER_USER" -p "$DOCKER_PASS"

                //                     cosign signing-config create \
                //                         --no-default-rekor \
                //                         --out /tmp/signing-config-no-tlog.json

                //                     cosign sign --key "$COSIGN_KEY" \
                //                         --signing-config /tmp/signing-config-no-tlog.json \
                //                         --new-bundle-format \
                //                         --yes \
                //                         "$IMAGE_REF"
                //                 '''
                //             }
                //         }
                //     }
                // }

                // stage('Verify Signature') {
                //     steps {
                //         container('cosign') {
                //             withCredentials([file(credentialsId: 'cosign-public-key', variable: 'COSIGN_PUB')]) {
                //                 sh '''
                //                     unset COSIGN_SIGNING_CONFIG
                //                     unset COSIGN_USE_SIGNING_CONFIG

                //                     cosign verify --key "$COSIGN_PUB" \
                //                         --insecure-ignore-tlog \
                //                         "$IMAGE_REF"
                //                 '''
                //             }
                //         }
                //     }
                // }

                // stage('Update Deployment Manifest') {
                //     steps {
                //         container('buildah') {
                //             withCredentials([usernamePassword(
                //                 credentialsId: 'github-cred',
                //                 usernameVariable: 'GIT_USER',
                //                 passwordVariable: 'GIT_PASS'
                //             )]) {
                //                 sh '''
                //                     set -e

                //                     export HOME=/tmp
                //                     git config --global --add safe.directory "$WORKSPACE"

                //                     # Manifest memakai TAG
                //                     sed -i "s#image: ghcr.io/rharff/user-service.*#image: ${IMAGE_FULL}#" k8s/deployment.yaml

                //                     git config user.name "Jenkins"
                //                     git config user.email "jenkins@localhost"

                //                     git add k8s/deployment.yaml
                //                     git commit -m "Update image to ${IMAGE_FULL} [skip ci]" || echo "No changes to commit"

                //                     git remote set-url origin "https://${GIT_USER}:${GIT_PASS}@${REPO_PATH}"
                //                     git push origin HEAD:main
                //                 '''
                //             }
                //         }
                //     }
                // }
            }
        }
    }

    post {
        success {
            echo "Pipeline selesai: image signed, verified, dan manifest diperbarui."
        }
        failure {
            echo "Pipeline gagal."
        }
        always {
            deleteDir()
        }
    }
}