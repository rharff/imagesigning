pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  imagePullSecrets:
  - name: ghcr-pull
  containers:
  - name: buildah
    image: quay.io/buildah/stable:latest
    command: ['sleep', 'infinity']
    securityContext:
      privileged: true
  - name: imgsign
    image: ghcr.io/rharff/imagesigning/signer:2
    command: ['sleep', 'infinity']
    workingDir: /home/jenkins/agent
    securityContext:
      runAsUser: 1000
      runAsGroup: 1000
"""
        }
    }

    environment {
        GHCR_USER  = "rharff"
        IMAGE_NAME = "ghcr.io/${GHCR_USER}/user-service"
        IMAGE_TAG  = "${BUILD_NUMBER}"
        IMAGE_FULL = "${IMAGE_NAME}:${IMAGE_TAG}"
        REPO_PATH  = "github.com/rharff/user-service.git"
        MANIFEST_PATH = "k8s/deployment.yaml"
    }

    stages {
        stage('Build Image') {
            when { expression { env.SKIP_BUILD != 'true' } }
            stages {
                stage('Build Image') {
                    steps {
                        container('buildah') {
                            sh 'buildah build --label ci.build="$BUILD_NUMBER" -t "$IMAGE_FULL" .'
                        }
                    }
                }

                stage('Push & Get Digest') {
                    steps {
                        container('buildah') {
                            withCredentials([usernamePassword(
                                credentialsId: 'github-cred',
                                usernameVariable: 'DOCKER_USER',
                                passwordVariable: 'DOCKER_PASS'
                            )]) {
                                sh '''
                                    buildah push \
                                        --creds "$DOCKER_USER:$DOCKER_PASS" \
                                        --digestfile /tmp/image-digest \
                                        "$IMAGE_FULL" \
                                        "docker://$IMAGE_FULL"
                                '''

                                script {
                                    def digest = sh(
                                        script: 'cat /tmp/image-digest',
                                        returnStdout: true
                                    ).trim()

                                    if (!(digest ==~ /sha256:[0-9a-fA-F]{64}/)) {
                                        error("Failed to get valid digest, got: ${digest}")
                                    }

                                    env.IMAGE_REF = "${IMAGE_NAME}@${digest}"
                                    echo "IMAGE_REF set to: ${env.IMAGE_REF}"
                                }
                            }
                        }
                    }
                }

                stage('Sign') {
                    steps {
                        container('imgsign') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'github-cred',
                                    usernameVariable: 'GHCR_USER',
                                    passwordVariable: 'GHCR_TOKEN'
                                ),
                                file(
                                    credentialsId: 'imgsign-private-key-ecdsa',
                                    variable: 'IMGSIGN_PRIVATE_KEY'
                                )
                            ]) {
                                sh 'imgsign sign --alg ecdsa "$IMAGE_REF"'
                            }
                        }
                    }
                }

                stage('Update Deployment Manifest') {
                    steps {
                        container('buildah') {
                            withCredentials([usernamePassword(
                                credentialsId: 'github-cred',
                                usernameVariable: 'GIT_USER',
                                passwordVariable: 'GIT_TOKEN'
                            )]) {
                                sh '''
                                    set -e

                                    test -f "$MANIFEST_PATH"

                                    sed -i -E \
                                        "s#^([[:space:]]*image:[[:space:]]*).*user-service.*#\\1${IMAGE_REF}#" \
                                        "$MANIFEST_PATH"

                                    grep -Fq "image: ${IMAGE_REF}" "$MANIFEST_PATH"

                                    export HOME=/tmp
                                    git config --global --add safe.directory "$WORKSPACE"
                                    git config user.name "Jenkins"
                                    git config user.email "jenkins@localhost"

                                    if git diff --quiet -- "$MANIFEST_PATH"; then
                                        echo "Manifest sudah menggunakan ${IMAGE_REF}"
                                        exit 0
                                    fi

                                    git add "$MANIFEST_PATH"
                                    git commit -m "Update user-service image to ${IMAGE_REF} [skip ci]"

                                    git remote set-url origin "https://${GIT_USER}:${GIT_TOKEN}@${REPO_PATH}"
                                    git push origin HEAD:main
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline selesai: image signed, verified, dan manifest diperbarui."
        }
        failure {
            echo "Pipeline gagal."
        }
    }
}
