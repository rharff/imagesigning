pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: buildah
    image: quay.io/buildah/stable:latest
    command: ['sleep', 'infinity']
    securityContext:
      privileged: true
  - name: imgsign
    image: ghcr.io/rharff/imagesigning/signer:latest
    command: ['sleep', 'infinity']
"""
        }
    }

    environment {
        GHCR_USER  = "rharff"
        IMAGE_NAME = "ghcr.io/${GHCR_USER}/user-service"
        IMAGE_TAG  = "${BUILD_NUMBER}"
        IMAGE_FULL = "${IMAGE_NAME}:${IMAGE_TAG}"
        REPO_PATH  = "github.com/rharff/user-service.git"
    }

    stages {
        stage('Check Trigger') {
            steps {
                script {
                    def author = sh(
                        script: 'git log -1 --pretty=%an',
                        returnStdout: true
                    ).trim()

                    if (author == 'Jenkins') {
                        env.SKIP_BUILD = 'true'
                        currentBuild.result = 'NOT_BUILT'
                        echo "Commit terakhir dari Jenkins, pipeline dilewati."
                    } else {
                        env.SKIP_BUILD = 'false'
                    }
                }
            }
        }

        stage('Main Pipeline') {
            when { expression { env.SKIP_BUILD != 'true' } }
            stages {
                stage('Build Image') {
                    steps {
                        container('buildah') {
                            sh 'buildah build --label ci.build="$BUILD_NUMBER" -t "$IMAGE_FULL" .'
                        }
                    }
                }

                stage('Push & Get Digest') {
                    steps {
                        container('buildah') {
                            withCredentials([usernamePassword(
                                credentialsId: 'github-cred',
                                usernameVariable: 'DOCKER_USER',
                                passwordVariable: 'DOCKER_PASS'
                            )]) {
                                sh '''
                                    buildah push \
                                        --creds "$DOCKER_USER:$DOCKER_PASS" \
                                        --digestfile /tmp/image-digest \
                                        "$IMAGE_FULL" \
                                        "docker://$IMAGE_FULL"
                                '''

                                script {
                                    def digest = sh(
                                        script: 'cat /tmp/image-digest',
                                        returnStdout: true
                                    ).trim()

                                    if (!digest?.startsWith("sha256:")) {
                                        error("Failed to get valid digest, got: ${digest}")
                                    }

                                    env.IMAGE_REF = "${IMAGE_NAME}@${digest}"
                                    echo "IMAGE_REF set to: ${env.IMAGE_REF}"
                                }
                            }
                        }
                    }
                }

                stage('Sign') {
                    steps {
                        container('imgsign') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'github-cred',
                                    usernameVariable: 'GHCR_USER',
                                    passwordVariable: 'GHCR_TOKEN'
                                ),
                                string(
                                    credentialsId: 'imgsign-private-key-mldsa',
                                    variable: 'IMGSIGN_PRIVATE_KEY'
                                )
                            ]) {
                                sh 'imgsign sign --alg mldsa65 "$IMAGE_REF"'
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline selesai: image signed, verified, dan manifest diperbarui."
        }
        failure {
            echo "Pipeline gagal."
        }
        always {
            deleteDir()
        }
    }
}
